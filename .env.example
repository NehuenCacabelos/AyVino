# Configuración de base de datos PostgreSQL para Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ayvino_db
# Puerto expuesto en el host: 5432 por defecto.
# Si contás con una instancia local de PostgreSQL activa en el puerto 5432, podés cambiarlo a 5433 (alternativa).
POSTGRES_PORT=5432
