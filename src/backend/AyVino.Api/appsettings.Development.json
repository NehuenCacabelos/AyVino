{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpsPolicy.HttpsRedirectionMiddleware": "None",
      "Microsoft.Hosting.Lifetime": "Information",
      "FluentMigrator": "Warning",
      "System": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss ",
        "ColorBehavior": "Enabled",
        "IncludeScopes": false
      }
    }
  }
}